{
  "name": "ens-metadata-v2",
  "version": "2.0.0",
  "description": "ENS Metadata Service V2 - Cloudflare Workers implementation for ENS v1 and v2 on Ethereum",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "predev": "node scripts/setup-local-r2.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "tsc && wrangler deploy --dry-run",
    "demo": "npx -y serve demo -p 3000"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.0",
    "@ensdomains/ens-avatar": "2.0.0-alpha.1",
    "@ensdomains/ensjs": "^3.7.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "adaptive-layout-composer": "^1.0.1",
    "bidi-js": "^1.0.3",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "harfbuzzjs": "github:mdtanrikulu/harfbuzzjs",
    "hono": "^4.6.3",
    "rasterize-wasm": "https://github.com/mdtanrikulu/rasterize-wasm/archive/refs/heads/lazy-font-loading.tar.gz",
    "tiny-brotli-dec-wasm": "^1.0.1",
    "viem": "^2.21.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.12.0",
    "miniflare": "^3.20241011.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "wrangler": "^4.36.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
