{
  "name": "ens-metadata-v2",
  "version": "2.0.0",
  "description": "ENS Metadata Service V2 - Cloudflare Workers implementation for ENS v1 and v2 on Ethereum",
  "main": "src/index.ts",
  "exports": "./src/index.ts",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply ens-metadata-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ens-metadata-db --remote --env=\"\"",
    "db:migrate:remote:stage": "wrangler d1 migrations apply ens-metadata-stage-db --remote --env stage",
    "setup:local": "node scripts/setup-local-r2.mjs && pnpm run db:migrate:local",
    "dev": "pnpm run setup:local && wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:stage": "wrangler deploy --env stage",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "tsc && wrangler deploy --dry-run --env=\"\" && wrangler deploy --dry-run --env stage",
    "demo": "pnx -y serve demo -p 3000"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.0",
    "@ensdomains/ens-avatar": "2.0.0-alpha.4",
    "@ensdomains/ensjs": "^3.7.0",
    "@ensdomains/etherloom": "0.1.0-alpha.4",
    "@resvg/resvg-wasm": "^2.6.2",
    "adaptive-layout-composer": "https://github.com/ensdomains/adaptive-layout-composer/archive/6e85e0bbc113a7e0880afbd23b7fff8f477f401b.tar.gz",
    "bidi-js": "^1.0.3",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "harfbuzzjs": "https://github.com/mdtanrikulu/harfbuzzjs/archive/48f2da5ebd3912c9b60188bf39a863e0099e9328.tar.gz",
    "hono": "^4.13.8",
    "rasterize-wasm": "https://github.com/ensdomains/rasterize-wasm/archive/ee6c572be3aeedc87694d8613a0c95f63337fbbb.tar.gz",
    "tiny-brotli-dec-wasm": "^1.0.1",
    "viem": "^2.21.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
