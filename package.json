{
  "name": "ens-metadata-v2",
  "version": "2.0.0",
  "description": "ENS Metadata Service V2 - Cloudflare Workers implementation with L1/L2 support",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "tsc && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.0",
    "@ensdomains/ensjs": "^3.7.0",
    "adaptive-layout-composer": "^1.0.0",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "hono": "^4.6.3",
    "viem": "^2.21.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.12.0",
    "miniflare": "^3.20241011.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "wrangler": "^4.36.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
