# ENS Metadata V2 Environment Variables

# ensnode GraphQL endpoint
ENSNODE_GRAPHQL_URL=https://api.ensnode.xyz/graphql

# Primary RPC endpoints
MAINNET_RPC_URL=https://ethereum.publicnode.com
NAMECHAIN_RPC_URL=https://namechain.rpc.url

# Fallback RPC endpoints (optional)
MAINNET_FALLBACK_RPC_1=https://rpc.ankr.com/eth
MAINNET_FALLBACK_RPC_2=https://cloudflare-eth.com
MAINNET_FALLBACK_RPC_3=https://eth.drpc.org
NAMECHAIN_FALLBACK_RPC_1=https://namechain-fallback-1.rpc.url
NAMECHAIN_FALLBACK_RPC_2=https://namechain-fallback-2.rpc.url

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: API keys for enhanced functionality
THE_GRAPH_API_KEY=
INFURA_API_KEY=
ALCHEMY_API_KEY=