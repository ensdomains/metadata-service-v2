# ENS Metadata V2 Environment Variables

# bigname indexer (per network; ENSv1 and ENSv2 names). Keep these in sync
# with wrangler.toml.
BIGNAME_MAINNET_URL=https://api.bigname.sh
BIGNAME_SEPOLIA_URL=https://sepolia.api.bigname.sh

# Primary RPC endpoints
MAINNET_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Fallback RPC endpoints (optional)
MAINNET_FALLBACK_RPC_1=https://rpc.ankr.com/eth
MAINNET_FALLBACK_RPC_2=https://cloudflare-eth.com
MAINNET_FALLBACK_RPC_3=https://eth.drpc.org
SEPOLIA_FALLBACK_RPC_1=https://rpc.ankr.com/eth_sepolia
SEPOLIA_FALLBACK_RPC_2=https://sepolia.drpc.org

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Max fetched avatar size in bytes (DoS guard; default 25 MB if unset/invalid).
# Note: avatars base64-inflate ~33% into the SVG, which caches in KV (25 MB limit),
# so avatars above ~18 MB render but won't be cached.
MAX_AVATAR_BYTES=26214400
# Max names per POST /batch-metadata request (default 100)
# MAX_BATCH_NAMES=100
# Optional: https origin of the IPFS gateway avatar and header media are fetched
# through (ipfs.io and dweb.link no longer serve HTTP fetches). Default: Filebase's
# public gateway, which is rate limited; use a dedicated gateway in production.
# IPFS_GATEWAY=https://ipfs.filebase.io

# Webhook auth (zigens indexer → POST /webhook).
# WEBHOOK_SECRET is the per-webhook HMAC key from the indexer, hex-encoded
# (64 hex chars). When set, requests must carry X-Webhook-Signature +
# X-Webhook-Timestamp; signature = HMAC-SHA256(hexDecode(secret), "{ts}.{body}").
# In production set it via `wrangler secret put WEBHOOK_SECRET` (not here).
WEBHOOK_SECRET=
# Optional: reject webhook timestamps further than this many seconds from now
# (replay window). Default 120.
# WEBHOOK_TOLERANCE_SECS=120
# Local dev only: accept webhooks without a secret (never set in production).
# WEBHOOK_ALLOW_UNAUTHENTICATED=true

# Optional: set to "true" to disable the per-IP rate limiter (e.g. local dev).
# RATE_LIMIT_DISABLED=false

# Optional: D1 (the last-resort tier) treats rows older than this many seconds
# as a miss on read. Default 604800 (7 days).
# D1_READ_MAX_AGE_SECS=604800
# Optional: the daily cron deletes D1 rows not updated for this many seconds.
# Default 2592000 (30 days).
# Whole seconds, at least 86400 (a smaller or malformed value keeps the default).
# D1_RETENTION_SECS=2592000