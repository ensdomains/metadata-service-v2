# ENS Metadata V2 Environment Variables

# GraphQL indexer endpoints (per network). Despite the ENSNODE_ prefix these are
# two different backends: mainnet/v1 = ENSNode subgraph; sepolia/v2 = the zigens
# ENS v2 indexer. The api version (v1 vs v2 queries) is selected by network in
# src/index.ts. Keep these in sync with wrangler.toml.
ENSNODE_MAINNET_URL=https://api.mainnet.ensnode.io/subgraph
ENSNODE_SEPOLIA_V2_URL=https://graphql.ens.dev
ENSNODE_SEPOLIA_V1_URL=https://api.sepolia.ensnode.io/subgraph

# Primary RPC endpoints
MAINNET_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Fallback RPC endpoints (optional)
MAINNET_FALLBACK_RPC_1=https://rpc.ankr.com/eth
MAINNET_FALLBACK_RPC_2=https://cloudflare-eth.com
MAINNET_FALLBACK_RPC_3=https://eth.drpc.org
SEPOLIA_FALLBACK_RPC_1=https://rpc.ankr.com/eth_sepolia
SEPOLIA_FALLBACK_RPC_2=https://sepolia.drpc.org

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Webhook auth (zigens indexer → /webhook/ensnode).
# WEBHOOK_SECRET is the per-webhook HMAC key from the indexer, hex-encoded
# (64 hex chars). When set, requests must carry X-Webhook-Signature +
# X-Webhook-Timestamp; signature = HMAC-SHA256(hexDecode(secret), "{ts}.{body}").
# In production set it via `wrangler secret put WEBHOOK_SECRET` (not here).
WEBHOOK_SECRET=
# Optional: reject webhook timestamps further than this many seconds from now
# (replay window). Default 300.
# WEBHOOK_TOLERANCE_SECS=300

# Optional: set to "true" to disable the per-IP rate limiter (e.g. local dev).
# RATE_LIMIT_DISABLED=false

# Optional: API keys for enhanced functionality
THE_GRAPH_API_KEY=
INFURA_API_KEY=
ALCHEMY_API_KEY=